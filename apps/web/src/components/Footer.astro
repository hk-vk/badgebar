---
import { asset } from './store';
---

<footer class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-4 border-t border-line px-5 py-8 text-sm text-muted sm:px-8">
  <p class="flex flex-wrap items-center gap-x-5 gap-y-2">
    <span>BadgeBar is open source under the MIT license.</span>
    <a href={asset('privacy/')} class="hover:text-ink">Privacy</a>
    <a href={asset('terms/')} class="hover:text-ink">Terms</a>
  </p>
  <div class="flex items-center gap-5">
    <p>App icons shown belong to their owners.</p>
    <div class="theme-switch" role="radiogroup" aria-label="Appearance">
      <button type="button" role="radio" data-theme-choice="system" aria-label="Match system" title="Match system">
        <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M5.5 14h5M8 11.5V14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
      </button>
      <button type="button" role="radio" data-theme-choice="light" aria-label="Light" title="Light">
        <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
      </button>
      <button type="button" role="radio" data-theme-choice="dark" aria-label="Dark" title="Dark">
        <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true"><path d="M13.5 9.6A5.6 5.6 0 0 1 6.4 2.5a5.6 5.6 0 1 0 7.1 7.1Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </div>
</footer>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
  const mark = (choice: string) =>
    buttons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeChoice === choice)));
  const w = window as unknown as { setTheme: (c: string) => string; savedTheme: () => string };
  mark(w.savedTheme());
  buttons.forEach((b) => b.addEventListener('click', () => mark(w.setTheme(b.dataset.themeChoice!))));
</script>
